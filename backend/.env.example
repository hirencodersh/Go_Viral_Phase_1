NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/social_media_platform
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-generated-48-byte-base64url-secret
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:5000
# Configure these for your SMTP provider. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Resend SMTP: set RESEND_API_KEY and SMTP_FROM to a sender on a verified domain.
# RESEND_API_KEY=re_your_resend_api_key
# SMTP_FROM=Socially <reset@your-verified-domain.com>
# When RESEND_API_KEY is set, the backend uses smtp.resend.com and SMTP username "resend".
# SMTP_PORT=465
# SMTP_SECURE=true
